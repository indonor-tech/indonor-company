NODE_ENV=development
PORT=5000
LOCAL_APP_URL=http://localhost:5000
# On Render this falls back to RENDER_EXTERNAL_URL if unset.
SERVER_APP_URL=https://indonor-tech.onrender.com
LOCAL_ADMIN_URL=http://localhost:5173
SERVER_ADMIN_URL=https://indonor-tech.vercel.app
# Add any additional trusted browser origins as a comma-separated list.
# Vite may use 5174+ if 5173 is already in use. Development also allows localhost automatically.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://indonor-tech.vercel.app
# Optional development-network workaround. Never enable invalid TLS certificates outside development.
MONGODB_DNS_SERVERS=
MONGODB_TLS_ALLOW_INVALID_CERTS=false
MONGODB_URI=mongodb://127.0.0.1:27017/indonor_hr
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
# Zoho SMTP: use smtp.zoho.com, smtp.zoho.eu, or smtp.zoho.in for your account region.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=your-zoho-mailbox@example.com
SMTP_PASSWORD=your-zoho-app-password
MAIL_FROM=your-zoho-mailbox@example.com
FILE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-use
# Used on employee / candidate / interview IDs, e.g. INDO-EMP-000001
COMPANY_CODE=INDO
LOCAL_SITE_URL=http://localhost:3000
SERVER_SITE_URL=https://indonortech.com
# Shared with the IndonorTech website. Leave empty in development to allow ingest without a key.
WEBSITE_ANALYTICS_INGEST_KEY=
# Google Calendar + Meet. Create an OAuth web client, then connect from CRM Settings while signed into this mailbox.
GOOGLE_CALENDAR_EMAIL=ghulam.shubhani9909@gmail.com
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:5000/api/v1/google-calendar/callback
