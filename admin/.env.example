# Vite selects the local URL in development and server URL in every other mode.
# In development the admin app proxies /api to the backend, so keep this path-only.
# Team photos are stored as /api/v1/website-team/photos/... so both local and Render work.
VITE_LOCAL_APP_URL=/api/v1
VITE_SERVER_APP_URL=https://indonor-tech.onrender.com/api/v1
VITE_LOCAL_ADMIN_URL=http://localhost:5173
VITE_SERVER_ADMIN_URL=https://indonor-tech.vercel.app
